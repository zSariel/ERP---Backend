# Aplicação
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
TRUST_PROXY=

# Limites da API
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=30
JSON_BODY_LIMIT=1mb

# Banco de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=controle_financeiro
DB_USER=root
DB_PASSWORD=

# SSL/TLS do banco
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=

# Sequelize
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Autenticação
JWT_SECRET=troque-por-um-segredo-forte-e-unico
